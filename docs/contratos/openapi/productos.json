    "components": {
        "schemas": {
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ProductoCambio": {
                "properties": {
                    "nombre": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 120,
                                "minLength": 2
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Nombre"
                    },
                    "descripcion": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 500
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Descripcion"
                    },
                    "categoria": {
                        "anyOf": [
                            {
                                "type": "string",
                                "enum": [
                                    "computadores",
                                    "celulares",
                                    "tablets",
                                    "accesorios",
                                    "otros"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Categoria"
                    },
                    "precio": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 100000000.0,
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "string",
                                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Precio"
                    },
                    "version_esperada": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Version Esperada",
                        "description": "Control de concurrencia optimista"
                    }
                },
                "type": "object",
                "title": "ProductoCambio"
            },
            "ProductoNuevo": {
                "properties": {
                    "sku": {
                        "type": "string",
                        "maxLength": 40,
                        "minLength": 3,
                        "title": "Sku"
                    },
                    "nombre": {
                        "type": "string",
                        "maxLength": 120,
                        "minLength": 2,
                        "title": "Nombre"
                    },
                    "descripcion": {
                        "type": "string",
                        "maxLength": 500,
                        "title": "Descripcion",
                        "default": ""
                    },
                    "categoria": {
                        "type": "string",
                        "enum": [
                            "computadores",
                            "celulares",
                            "tablets",
                            "accesorios",
                            "otros"
                        ],
                        "title": "Categoria"
                    },
                    "precio": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 100000000.0,
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "string",
                                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$"
                            }
                        ],
                        "title": "Precio"
                    }
                },
                "type": "object",
                "required": [
                    "sku",
                    "nombre",
                    "categoria",
                    "precio"
                ],
                "title": "ProductoNuevo"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
