    "components": {
        "schemas": {
            "EntradaRiesgo": {
                "properties": {
                    "ingresos_mensuales_cop": {
                        "type": "number",
                        "maximum": 100000000.0,
                        "exclusiveMinimum": 0.0,
                        "title": "Ingresos Mensuales Cop"
                    },
                    "obligaciones_mensuales_cop": {
                        "type": "number",
                        "maximum": 100000000.0,
                        "minimum": 0.0,
                        "title": "Obligaciones Mensuales Cop"
                    },
                    "tipo_empleo": {
                        "anyOf": [
                            {
                                "type": "string",
                                "enum": [
                                    "dependiente",
                                    "independiente",
                                    "temporal"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Tipo Empleo"
                    },
                    "antiguedad_laboral_meses": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 600.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Antiguedad Laboral Meses"
                    },
                    "meses_historial_crediticio": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 600.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Meses Historial Crediticio"
                    },
                    "creditos_previos": {
                        "type": "integer",
                        "maximum": 100.0,
                        "minimum": 0.0,
                        "title": "Creditos Previos"
                    },
                    "atrasos_previos_30d": {
                        "type": "integer",
                        "maximum": 100.0,
                        "minimum": 0.0,
                        "title": "Atrasos Previos 30D"
                    },
                    "porcentaje_pago_puntual": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 100.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Porcentaje Pago Puntual"
                    },
                    "monto_solicitado_cop": {
                        "type": "number",
                        "maximum": 100000000.0,
                        "exclusiveMinimum": 0.0,
                        "title": "Monto Solicitado Cop"
                    },
                    "plazo_meses": {
                        "type": "integer",
                        "title": "Plazo Meses"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "ingresos_mensuales_cop",
                    "obligaciones_mensuales_cop",
                    "creditos_previos",
                    "atrasos_previos_30d",
                    "monto_solicitado_cop",
                    "plazo_meses"
                ],
                "title": "EntradaRiesgo",
                "description": "Caracter\u00edsticas de entrada (sin identificadores ni etiqueta)."
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "SolicitudPrestamo": {
                "properties": {
                    "producto_id": {
                        "type": "integer",
                        "exclusiveMinimum": 0.0,
                        "title": "Producto Id"
                    },
                    "cantidad": {
                        "type": "integer",
                        "maximum": 5.0,
                        "minimum": 1.0,
                        "title": "Cantidad"
                    },
                    "plazo_meses": {
                        "type": "integer",
                        "title": "Plazo Meses"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "producto_id",
                    "cantidad",
                    "plazo_meses"
                ],
                "title": "SolicitudPrestamo"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
