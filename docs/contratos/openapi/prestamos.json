            "get": {
                "summary": "Monitoreo",
                "description": "Volumen y tasa de decisiones por versi\u00f3n, y drift (PSI) de las entradas recientes frente a entrenamiento.",
                "operationId": "monitoreo_modelo_monitoreo_get",
                "parameters": [
                    {
                        "name": "ventana",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 5000,
                            "minimum": 30,
                            "default": 500,
