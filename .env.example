# Plantilla de configuración. NO ponga secretos reales aquí.
# Genere el archivo .env real (ignorado por git) con:
#   Linux/macOS:  ./scripts/init-env.sh
#   Windows:      powershell -ExecutionPolicy Bypass -File .\scripts\init-env.ps1
# Los valores <generado> se reemplazan por cadenas aleatorias.

# --- Seguridad
JWT_SECRET=<generado>
SESION_MINUTOS=30

# --- Cuentas de la demostración (las contraseñas se generan; quedan solo en .env)
ADMIN_EMAIL=admin@credimarket.co
ADMIN_PASSWORD=<generado>
DEMO_CLIENTE_PASSWORD=<generado>

# --- PostgreSQL: una instancia, una base y un usuario restringido por servicio
POSTGRES_PASSWORD=<generado>
PRODUCTOS_DB_PASSWORD=<generado>
CLIENTES_DB_PASSWORD=<generado>
PRESTAMOS_DB_PASSWORD=<generado>
INVENTARIO_DB_PASSWORD=<generado>

# --- RabbitMQ
RABBITMQ_USER=credimarket
RABBITMQ_PASSWORD=<generado>
MAX_REINTENTOS=3

# --- Tiempos (segundos)
CACHE_TTL_SEGUNDOS=60
PENDIENTE_TIMEOUT_SEGUNDOS=600
RESERVA_TTL_SEGUNDOS=1800

# --- Reglas de negocio
MONTO_MIN_COP=300000
MONTO_MAX_COP=15000000

# --- URLs públicas que usa el navegador y orígenes CORS permitidos
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PRODUCTOS_PUBLIC_URL=http://localhost:8001
CLIENTES_PUBLIC_URL=http://localhost:8002
PRESTAMOS_PUBLIC_URL=http://localhost:8003
INVENTARIO_PUBLIC_URL=http://localhost:8004
MLFLOW_PUBLIC_URL=http://localhost:5000
